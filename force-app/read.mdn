.slds-modal {
    z-index: 9001;
}

.slds-backdrop {
    z-index: 9000;
}

.slds-modal__container {
    width: 90%;
    max-width: 680px;
}

.slds-modal__header {
    position: relative;
    padding: 16px 20px;
    border-bottom: 1px solid #e5e5e5;
}

.modalTitle {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    text-align: left;
}

.closeButton {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

.closeButton:hover {
    background: #f3f3f3;
}

.modalBody {
    padding: 20px;
    min-height: 180px;
    max-height: 65vh;
    overflow-y: auto;
}

.formGrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 18px;
    row-gap: 14px;
}

.fullWidth {
    grid-column: 1 / -1;
}

.modalFooter {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-top: 1px solid #e5e5e5;
}

.cancelButton {
    min-width: 80px;
    height: 34px;
    padding: 0 16px;
    background: #ffffff;
    border: 1px solid #d8dde6;
    border-radius: 4px;
    color: #181818;
    font-size: 12px;
    cursor: pointer;
}

.cancelButton:hover {
    background: #f3f3f3;
}

.saveButton {
    min-width: 80px;
    height: 34px;
    padding: 0 18px;
    background: #0176d3;
    border: 1px solid #0176d3;
    border-radius: 4px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
}

.saveButton:hover {
    background: #014486;
}

@media screen and (max-width: 1100px) {
    .cardsContainer {
        grid-template-columns: 1fr;
    }
}

@media screen and (max-width: 600px) {
    .formGrid {
        grid-template-columns: 1fr;
    }

    .fullWidth {
        grid-column: auto;
    }

    .loyaltyBody {
        flex-direction: column;
    }

    .tierCard {
        width: 100%;
    }

    .infoGrid {
        grid-template-columns: 1fr 1fr;
    }

    .gamingGrid {
        grid-template-columns: 1fr 1fr;
    }
}