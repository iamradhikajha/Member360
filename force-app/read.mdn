                    <div class="headerLeft">
                        <div class="headerIcon loyaltyIcon"><lightning-icon icon-name="standard:product" alternative-text="Loyalty Status" size="x-small"></lightning-icon></div>
                        <h2>Loyalty Status</h2>
                    </div>
                </div>

                <!-- Loyalty details temporarily commented out
                <div class="loyaltyBody">
                    <div class="tierCard">
                        <div class="tierName">CLASSIC TIER</div>
                        <div class="stars"><span>★</span><span>★</span><span>★</span><span>★</span><span class="emptyStar">★</span></div>
