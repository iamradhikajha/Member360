                    <div class="headerLeft">
                        <div class="headerIcon hostIcon"><lightning-icon icon-name="standard:avatar" alternative-text="Host" size="x-small"></lightning-icon></div>
                        <h2>Host &amp; Relationship</h2>
                    </div>
                    <button type="button" class="editButton" data-section="host" onclick={handleEdit}>Edit</button>
                </div>
                <!-- <div class="hostBody">
                    <div class="hostTop">
                        <div class="hostImage"><img src="https://i.pravatar.cc/100?img=12" alt="Assigned Host"></div>
                        <div class="hostInfo">
                            <div><span class="label">Assigned Host</span><span class="linkValue">{hostData.assignedHost}</span></div>
                            <div><span class="label">Last Contact</span><span class="value">{hostData.lastContact}</span></div>
                        </div>
                    </div>
                    <div class="hostDetails">
