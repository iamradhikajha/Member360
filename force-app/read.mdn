import { LightningElement, api } from 'lwc';

export default class MemberSummaryCards extends LightningElement {
    @api member;

    isModalOpen = false;
    isProfileEdit = false;
    // isHostEdit = false;
    modalTitle = '';
    editData = {};

    // hostData = {
    //     assignedHost: '',
    //     lastContact: '10 Sep 2026',
    //     preferredContact: 'WhatsApp',
    //     nextFollowUp: '23 Sep 2026',
    //     notes: 'Prefers weekend getaways and dining experiences.'
    // };

    get segmentClass() {
        const segment = (this.member?.segment__c || '').trim().toLowerCase();

        switch (segment) {
            case 'basic':
                return 'segmentBadge basic';
            case 'premium':
                return 'segmentBadge premium';
            case 'vvip':
                return 'segmentBadge vvip';
            case 'business':
                return 'segmentBadge business';
            default:
                return 'segmentBadge default';
        }
    }

    // get assignedHost() {
    //     return this.member?.Owner?.Name || '';
    // }

    handleEdit(event) {
        const section = event.currentTarget.dataset.section;
        this.isModalOpen = true;

        if (section === 'profile') {
            this.isProfileEdit = true;
            // this.isHostEdit = false;
            this.modalTitle = 'Edit Member Profile';

            this.editData = {
                preferredLanguage: this.member?.preferredLanguage || '',
                nationality: this.member?.nationality || '',
                preferredProperty: this.member?.preferredProperty || '',
                preferredChannel: this.member?.preferredChannel || '',
                gamingSegment: this.member?.segment__c || '',
                preferredGames: this.member?.preferredGames || ''
            };
        }

        // else if (section === 'host') {
        //     this.isProfileEdit = false;
        //     this.isHostEdit = true;
        //     this.modalTitle = 'Edit Host & Relationship';
        //     this.editData = { ...this.hostData };
        // }
    }

    handleFieldChange(event) {
        const field = event.target.dataset.field;
        const value = event.target.value;

        this.editData = {
            ...this.editData,
            [field]: value
        };
    }

    handleSave() {
        if (this.isProfileEdit) {
            console.log('Profile Saved:', JSON.stringify(this.editData));
        }

        // if (this.isHostEdit) {
        //     this.hostData = {
        //         ...this.hostData,
        //         ...this.editData
        //     };
        // }

        console.log('Saved Data:', JSON.stringify(this.editData));
        this.closeModal();
    }

    handleCancel() {
        this.closeModal();
    }

    closeModal() {
        this.isModalOpen = false;
        this.isProfileEdit = false;
        // this.isHostEdit = false;
        this.modalTitle = '';
        this.editData = {};
    }
}







.cardsContainer {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    box-sizing: border-box;
}

.summaryCard {
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 7px;
    overflow: hidden;
    min-width: 0;
    box-sizing: border-box;
}

.cardHeader {
    min-height: 38px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    border-bottom: 1px solid #e8e8e8;
    box-sizing: border-box;
}

.headerLeft {
    display: flex;
    align-items: center;
    gap: 8px;
}

.headerLeft h2 {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    color: #181818;
}

.headerIcon {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
}

.profileIcon {
    background: #eaf4ff;
}

.loyaltyIcon {
    background: #f0eaff;
}

/*
.hostIcon {
    background: #e7f7f1;
}
*/

.editButton {
    border: 1px solid #d8dde6;
    background: #ffffff;
    color: #0176d3;
    font-size: 9px;
    padding: 3px 11px;
    border-radius: 4px;
    cursor: pointer;
}

.editButton:hover {
    background: #f3f9ff;
    border-color: #0176d3;
}

.cardBody {
    padding: 10px 12px;
    box-sizing: border-box;
}

.sectionTitle {
    color: #0176d3;
    font-size: 9px;
    font-weight: 700;
    margin-bottom: 8px;
}

.gamingTitle {
    margin-top: 15px;
}

.infoGrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 16px;
    row-gap: 10px;
}

.infoItem {
    min-width: 0;
}

.label {
    display: block;
    font-size: 8px;
    color: #706e6b;
    margin-bottom: 3px;
}

.value {
    display: block;
    font-size: 9px;
    color: #181818;
    font-weight: 500;
    line-height: 1.35;
}

.gamingGrid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
}

.linkValue {
    display: block;
    color: #0176d3;
    font-size: 9px;
    font-weight: 500;
}

.segmentBadge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 8px;
    font-weight: 600;
    line-height: 1.2;
}

.segmentBadge.basic {
    background: #fef3c7;
    color: #92400e;
}

.segmentBadge.premium {
    background: #ede9fe;
    color: #6d28d9;
}

.segmentBadge.vvip {
    background: #fee2e2;
    color: #b91c1c;
}

.segmentBadge.business {
    background: #dcfce7;
    color: #15803d;
}

.segmentBadge.default {
    background: #e5e7eb;
    color: #374151;
}

.loyaltyBody {
    display: flex;
    gap: 12px;
    padding: 9px 12px;
    box-sizing: border-box;
}

.tierCard {
    width: 130px;
    min-width: 130px;
    background: #4930c4;
    border-radius: 6px;
    padding: 9px;
    color: #ffffff;
    box-sizing: border-box;
}

.tierName {
    font-size: 9px;
    font-weight: 700;
    text-align: center;
}

.stars {
    text-align: center;
    font-size: 11px;
    letter-spacing: 1px;
    margin-top: 4px;
}

.emptyStar {
    opacity: 0.35;
}

.currentTier {
    font-size: 8px;
    text-align: center;
    margin-top: 3px;
}

.tierAmount {
    font-size: 20px;
    font-weight: 700;
    text-align: center;
    margin-top: 4px;
}

.tierAmount span {
    font-size: 8px;
}

.requiredText {
    font-size: 8px;
    text-align: center;
    margin-top: 2px;
}

.progressContainer {
    flex: 1;
    min-width: 0;
}

.progressHeader {
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    margin-bottom: 6px;
}

.progressBar {
    height: 9px;
    width: 100%;
    background: #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
}

.progressFill {
    width: 68%;
    height: 100%;
    background: #7b35d5;
}

.nextTier {
    margin-top: 9px;
    font-size: 9px;
}

.nextTier span {
    color: #555555;
}

.nextTier strong {
    margin-left: 4px;
    color: #172b7a;
}

.upgradeText {
    font-size: 8px;
    margin-top: 2px;
    color: #555555;
}

.loyaltyMessage {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0 12px 10px;
    padding: 8px;
    background: #eef6ff;
    border-radius: 5px;
    color: #36566f;
    font-size: 8px;
}

