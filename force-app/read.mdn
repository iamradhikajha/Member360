                    </div>
                    <div class="notes"><span class="label">Notes</span><p>{hostData.notes}</p></div>
                </div> -->
            </div>
        </div>

        <template if:true={isModalOpen}>
            <section role="dialog" tabindex="-1" aria-modal="true" aria-labelledby="editModalHeading" class="slds-modal slds-fade-in-open">
                <div class="slds-modal__container">
                    <header class="slds-modal__header">
                        <button type="button" class="closeButton" title="Close" onclick={handleCancel}>
                            <lightning-icon icon-name="utility:close" alternative-text="Close" size="x-small"></lightning-icon>
                        </button>
                        <h2 id="editModalHeading" class="modalTitle">{modalTitle}</h2>
                    </header>

                    <div class="slds-modal__content modalBody">
                        <template if:true={isProfileEdit}>
                            <div class="formGrid">
                                <lightning-input label="Preferred Language" value={editData.preferredLanguage} data-field="preferredLanguage" onchange={handleFieldChange}></lightning-input>
                                <lightning-input label="Nationality" value={editData.nationality} data-field="nationality" onchange={handleFieldChange}></lightning-input>
                                <lightning-input label="Preferred Property" value={editData.preferredProperty} data-field="preferredProperty" onchange={handleFieldChange}></lightning-input>
                                <lightning-input label="Preferred Channel" value={editData.preferredChannel} data-field="preferredChannel" onchange={handleFieldChange}></lightning-input>
